{
  "AlarmName": "DecisionTwin-High-5xx-Rate",
  "AlarmDescription": "Triggers if DecisionTwin backend returns more than 5 5xx errors in 5 minutes.",
  "Namespace": "AWS/ElasticBeanstalk",
  "MetricName": "HTTPCode_Backend_5XX",
  "Dimensions": [
    {
      "Name": "EnvironmentName",
      "Value": "Decisiontwin-env"
    }
  ],
  "Statistic": "Sum",
  "Period": 300,
  "EvaluationPeriods": 1,
  "Threshold": 5,
  "ComparisonOperator": "GreaterThanThreshold",
  "AlarmActions": []
},
{
  "AlarmName": "DecisionTwin-High-Latency",
  "AlarmDescription": "Triggers if DecisionTwin simulation endpoint latency p95 exceeds 2000ms.",
  "Namespace": "AWS/ElasticBeanstalk",
  "MetricName": "Latency",
  "Dimensions": [
    {
      "Name": "EnvironmentName",
      "Value": "Decisiontwin-env"
    }
  ],
  "Statistic": "Average",
  "Period": 300,
  "EvaluationPeriods": 2,
  "Threshold": 2.0,
  "ComparisonOperator": "GreaterThanOrEqualToThreshold",
  "AlarmActions": []
}
